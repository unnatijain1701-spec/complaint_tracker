PORT=3000
DATABASE_URL=postgres://user:password@localhost:5432/complaint_tracker
UPLOAD_DIR=./data/uploads

# Session cookie signing secret — set a long random string in production
# (sessions persist in Postgres via connect-pg-simple, but only if this
# stays stable across restarts).
SESSION_SECRET=

# Email alerts (nodemailer, generic SMTP — works with Gmail app passwords,
# Resend, SendGrid, or any other provider's SMTP relay). Leave unset to
# disable email sending (the app logs instead of sending).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Comma-separated recipient list for Critical/High alerts and the daily
# overdue digest. No default on purpose — fill in before relying on alerts.
ALERT_RECIPIENTS=
